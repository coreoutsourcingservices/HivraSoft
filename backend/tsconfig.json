{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",

    "rootDir": "./src",
    "outDir": "./dist",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,

    "types": ["node"],

    "sourceMap": true,

    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
, "src/server.ts"  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}